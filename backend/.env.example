# Copy this file to .env for LOCAL development.
# On Render, you'll set these as Environment Variables in the dashboard instead
# of uploading a .env file.

# MongoDB Atlas connection string (see README for how to get this)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/facebook_clone?retryWrites=true&w=majority

# Port the server listens on (Render sets this automatically in production)
PORT=5000

# Comma-separated list of allowed frontend origins for CORS
# Example once deployed: https://your-frontend.vercel.app
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
